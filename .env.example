# ConstruxNet — Umgebungsvariablen (eigener Login, KEIN Satellite-Modus)

# --- Clerk (eigenständige Instanz) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Sign-in/Sign-up werden im ClerkProvider (app/layout.tsx) auf die
# selbst-gehosteten Seiten /sign-in und /sign-up gesetzt. Optional per ENV:
# NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# WICHTIG: KEINE Satellite-Variablen setzen. Falls aus dem alten Setup noch
# vorhanden, in Vercel entfernen:
#   NEXT_PUBLIC_CLERK_IS_SATELLITE
#   NEXT_PUBLIC_CLERK_DOMAIN
#   (und auf SourceOn zeigende NEXT_PUBLIC_CLERK_SIGN_IN_URL/SIGN_UP_URL)

# --- Supabase (eigenständiges ConstruxNet-Projekt) ---
NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...
